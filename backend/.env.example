# Vobiz Voice Platform Credentials
VOBIZ_AUTH_ID=YOUR_VOBIZ_AUTH_ID
VOBIZ_AUTH_TOKEN=YOUR_VOBIZ_AUTH_TOKEN
VOBIZ_FROM_NUMBER=+15550100000
VOBIZ_API_URL=https://api.vobiz.ai

# SIP endpoint the softphone registers as
VOBIZ_SIP_USER=admin
VOBIZ_SIP_PASSWORD=your_sip_password
VOBIZ_REGISTRAR=registrar.vobiz.ai

# Server Port
PORT=8092

# ClickUp API Credentials & Target Location
CLICKUP_API_TOKEN=pk_YOUR_CLICKUP_PERSONAL_API_TOKEN
CLICKUP_TEAM_ID=YOUR_CLICKUP_TEAM_ID
CLICKUP_LIST_ID=YOUR_CLICKUP_LIST_ID
CLICKUP_API_URL=https://api.clickup.com/api/v2

# Public Tunnel Base URL (Optional - override auto-detected Cloudflare tunnel)
# TUNNEL_URL=https://your-custom-tunnel.trycloudflare.com

# Recording link HMAC signing secret & TTL
SIGNING_SECRET=your_random_secret_string
RECORDING_URL_TTL_SECONDS=900

# Set to 1 to allow simulated CRM data when ClickUp API token is not configured
ALLOW_MOCK=1
