# Vobiz account credentials (console.vobiz.ai -> API credentials)
VOBIZ_AUTH_ID=YOUR_VOBIZ_AUTH_ID
VOBIZ_AUTH_TOKEN=YOUR_VOBIZ_AUTH_TOKEN
# Caller ID for outbound calls, and the DID customers call. Must be a number on this account.
VOBIZ_FROM_NUMBER=+91XXXXXXXXXX
VOBIZ_API_URL=https://api.vobiz.ai

# SIP endpoint the softphone registers as. Use the *stored* username Vobiz
# returned when the endpoint was created, not the one you submitted.
VOBIZ_SIP_USER=
VOBIZ_SIP_PASSWORD=
VOBIZ_REGISTRAR=registrar.vobiz.ai

# Server port
PORT=8092

# ClickUp: a personal API token (pk_...) and the list that receives call tasks
CLICKUP_API_TOKEN=pk_YOUR_CLICKUP_PERSONAL_API_TOKEN
CLICKUP_LIST_ID=YOUR_CLICKUP_LIST_ID
CLICKUP_API_URL=https://api.clickup.com/api/v2
# Optional: a status that exists in that list. Left unset, tasks get the list's default status.
# CLICKUP_TASK_STATUS=

# Public base URL. Optional: `npm run tunnel` writes backend/tunnel-url.txt, which is used when this is unset.
# TUNNEL_URL=https://your-tunnel.trycloudflare.com

# Extra browser origins allowed to call this backend, comma-separated.
# ALLOWED_ORIGINS=

# Recording link HMAC signing secret and lifetime. Set the secret explicitly,
# or every restart invalidates the playback links already written into ClickUp.
SIGNING_SECRET=change_me_to_a_long_random_string
RECORDING_URL_TTL_SECONDS=900
