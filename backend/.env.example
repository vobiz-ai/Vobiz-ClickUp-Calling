# Deployment configuration only.
#
# No Vobiz Auth ID, Auth Token, number or SIP endpoint goes here. Agents sign
# in from the panel with their own Vobiz account (Auth ID + Auth Token), and the
# backend sets up their SIP endpoint in that account. SIP Direct sign-in takes
# an existing endpoint's credentials, typed in the panel.

# Server port
PORT=8092

# Public HTTPS base URL Vobiz can reach. Optional: `npm run tunnel` writes
# backend/tunnel-url.txt, which is used when this is unset. Each account's
# Vobiz application is created with <this>/answer as its answer URL.
# PUBLIC_BASE_URL=https://your-public-host.example.com

# Where the account:agent -> endpoint map is kept (no secrets; mode 0600).
# DATA_DIR=backend/data

# Vobiz API and SIP registrar hosts. Leave as they are.
# VOBIZ_API_URL=https://api.vobiz.ai
# VOBIZ_REGISTRAR=registrar.vobiz.ai

# ClickUp: a personal API token (pk_...) and the list that receives call tasks
CLICKUP_API_TOKEN=pk_YOUR_CLICKUP_PERSONAL_API_TOKEN
CLICKUP_LIST_ID=YOUR_CLICKUP_LIST_ID
CLICKUP_API_URL=https://api.clickup.com/api/v2
# Optional: a status that exists in that list. Left unset, tasks get the list's default status.
# CLICKUP_TASK_STATUS=

# Extra browser origins allowed to call this backend, comma-separated.
# ALLOWED_ORIGINS=

# Recording link HMAC signing secret and lifetime. Set the secret explicitly,
# or every restart invalidates the playback links already written into ClickUp.
SIGNING_SECRET=change_me_to_a_long_random_string
RECORDING_URL_TTL_SECONDS=900
